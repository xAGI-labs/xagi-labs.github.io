{
  "action": "redirect",
  "description": "Move all xagi.in public traffic to GitHub Pages without Worker invocations",
  "enabled": true,
  "expression": "(http.host in {\"xagi.in\" \"www.xagi.in\"})",
  "action_parameters": {
    "from_value": {
      "status_code": 302,
      "target_url": {
        "expression": "concat(\"https://xagi-labs.github.io\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  }
}
