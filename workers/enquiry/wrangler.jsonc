{
  "name": "xagi-dataset-enquiry",
  "main": "index.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ENABLED": "false",
    "FROM_EMAIL": "enquiries@xagi.in"
  },
  "send_email": [{ "name": "EMAIL", "destination_address": "saurav@xagi.in" }],
  "triggers": { "crons": ["17 3 * * *"] }
  // Before deployment, add the provisioned D1 binding and exact route:
  // "d1_databases": [{ "binding": "DB", "database_name": "xagi-enquiry-leads", "database_id": "<provisioned UUID>" }],
  // "routes": [{ "pattern": "xagi.in/api/dataset-enquiry*", "zone_name": "xagi.in" }]
  // Deploy with ENABLED=false until sender, recipient and Turnstile are verified.
}
